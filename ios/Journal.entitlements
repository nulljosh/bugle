<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- the app's own group first, so the account keeps saving where it always has; the shared one is the Inbox -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.nulljosh.journal</string>
		<string>$(AppIdentifierPrefix)com.nulljosh.journal.shared</string>
	</array>
</dict>
</plist>
