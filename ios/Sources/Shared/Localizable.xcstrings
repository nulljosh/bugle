    "Blindspot: only center outlets covered this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطة عمياء: تناولت هذا وسائل إعلام الوسط فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinder Fleck: Nur Medien der Mitte haben darüber berichtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto ciego: solo medios de centro cubrieron esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Angle mort : seuls des médias du centre en ont parlé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודה עיוורת: רק כלי תקשורת מרכזיים סיקרו את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनदेखा कोना: इसे केवल मध्य-झुकाव वाले मीडिया ने कवर किया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik buta: hanya media tengah yang meliput ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto cieco: ne hanno parlato solo testate di centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "死角：中道のメディアだけが報じました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사각지대: 중도 매체만 보도했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinde vlek: alleen media uit het midden berichtten hierover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Martwy punkt: o tym pisały tylko media centrowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto cego: só veículos de centro cobriram isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слепая зона: это освещали только центристские СМИ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blindfläck: Det här bevakades bara av mittenmedier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör nokta: Bunu yalnızca merkez yayın organları ele aldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm mù: chỉ các hãng tin trung lập đưa tin về việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盲点：只有中间立场的媒体报道了此事。"
