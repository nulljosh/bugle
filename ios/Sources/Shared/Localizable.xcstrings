    "Bring your feeds from another reader, or take them with you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل موجزاتك من قارئ آخر أو خذها معك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring deine Feeds aus einem anderen Reader mit oder nimm sie mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae tus feeds desde otro lector o llévatelos contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez vos flux depuis un autre lecteur, ou emportez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta i tuoi feed da un altro lettore, o portali con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのリーダーからフィードを持ち込んだり、持ち出したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 리더에서 피드를 가져오거나 내보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je feeds mee uit een andere lezer, of neem ze mee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga seus feeds de outro leitor ou leve-os com você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他阅读器导入订阅源，或随身带走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從其他閱讀器匯入訂閱源，或隨身帶走。"
          }
        }
      }
    },
    "Bugle finds the site's feed and adds it the next time you open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر Bugle على موجز الموقع ويضيفه في المرة القادمة التي تفتحه فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle findet den Feed der Website und fügt ihn beim nächsten Öffnen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle encuentra el feed del sitio y lo añade la próxima vez que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle trouve le flux du site et l'ajoute à la prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle trova il feed del sito e lo aggiunge alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugleがサイトのフィードを見つけ、次に開いたときに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle이 사이트의 피드를 찾아 다음에 열 때 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle vindt de feed van de site en voegt die toe als je de app weer opent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bugle encontra o feed do site e o adiciona na próxima vez que você abrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle 会找到该网站的订阅源，并在你下次打开时添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle 會找到該網站的訂閱源，並在你下次開啟時加入。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
