    "Open a few stories to see how what you read leans.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح بعض الأخبار لترى ميول ما تقرؤه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein paar Artikel, um zu sehen, wohin deine Lektüre tendiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre algunas noticias para ver hacia dónde se inclina lo que lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez quelques articles pour voir la tendance de ce que vous lisez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו כמה כתבות כדי לראות לאן נוטה מה שאתם קוראים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ कहानियाँ खोलें और देखें कि आप जो पढ़ते हैं उसका झुकाव कैसा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka beberapa berita untuk melihat ke mana kecenderungan bacaan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri qualche articolo per vedere l'orientamento di ciò che leggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか記事を開くと、読んでいるものの傾向がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사를 몇 개 열면 읽는 내용의 성향을 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een paar artikelen om te zien welke kant je leesgedrag op neigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz kilka artykułów, aby zobaczyć, w którą stronę skłania się to, co czytasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra algumas notícias para ver a tendência do que você lê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте несколько материалов, чтобы увидеть, к чему склоняется то, что вы читаете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna några artiklar för att se hur det du läser lutar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuduklarınızın hangi yöne eğildiğini görmek için birkaç haber açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở vài bài báo để xem những gì bạn đọc nghiêng về phía nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开几篇报道，就能看到你阅读内容的倾向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開幾篇報導，就能看到你閱讀內容的傾向。"
          }
        }
      }
    },
