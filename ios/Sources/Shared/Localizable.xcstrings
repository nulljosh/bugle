    "No entries yet. Add a feed or pull to refresh.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عناصر بعد. أضف موجزًا أو اسحب للتحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge. Füge einen Feed hinzu oder ziehe zum Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay entradas. Añade un feed o desliza para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun article pour l’instant. Ajoutez un flux ou tirez pour actualiser."
          }
