    "Covered by %lld newsrooms. Leans are Bugle's own rating of each outlet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %lld Redaktionen berichtet. Die Ausrichtung ist Bugles eigene Einschätzung jedes Mediums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierta por %lld redacciones. Las tendencias son la valoración propia de Bugle de cada medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvert par %lld rédactions. Les tendances sont l'évaluation de chaque média par Bugle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 社の報道機関が報じています。傾向は各メディアに対するBugle独自の評価です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberta por %lld redações. As tendências são a avaliação do próprio Bugle sobre cada veículo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 %lld 家新闻机构报道。倾向是 Bugle 对各媒体的自有评级。"
          }
        }
      }
    },
