    "Swipe right on a feed to get a notification when it posts. Swipe left to remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب موجزًا لليمين لتصلك إشعارات عند النشر. اسحب لليسار لإزالته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische bei einem Feed nach rechts, um bei neuen Beiträgen benachrichtigt zu werden. Nach links zum Entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha en un feed para recibir un aviso cuando publique. Desliza a la izquierda para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un flux vers la droite pour être averti quand il publie. Vers la gauche pour le retirer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו ימינה על הזנה כדי לקבל התראה כשיש בה פרסום חדש. החליקו שמאלה כדי להסיר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ीड पर दाईं ओर स्वाइप करें ताकि नई पोस्ट आने पर सूचना मिले। हटाने के लिए बाईं ओर स्वाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser feed ke kanan untuk mendapat notifikasi saat ada postingan baru. Geser ke kiri untuk menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a destra su un feed per ricevere una notifica quando pubblica. Scorri a sinistra per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードを右にスワイプすると投稿時に通知されます。左にスワイプで削除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드를 오른쪽으로 쓸면 새 글이 올라올 때 알림을 받습니다. 왼쪽으로 쓸면 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts op een feed om een melding te krijgen als die iets plaatst. Veeg naar links om hem te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń kanał w prawo, aby dostawać powiadomienia o nowych wpisach. Przesuń w lewo, aby go usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um feed para a direita para receber um aviso quando ele publicar. Para a esquerda para removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните ленту вправо, чтобы получать уведомления о новых публикациях. Смахните влево, чтобы удалить её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt höger på ett flöde för att få en avisering när det publicerar något nytt. Svep åt vänster för att ta bort det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir akışta sağa kaydırarak yeni gönderiler için bildirim alın. Kaldırmak için sola kaydırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt phải một nguồn tin để nhận thông báo khi có bài mới. Vuốt trái để xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在订阅源上向右轻扫，更新时会收到通知。向左轻扫可移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在訂閱源上向右滑動，更新時會收到通知。向左滑動可移除。"
          }
        }
      }
    },
    "Swipe right on a story, or press and hold it, to save it here. Saved stories open without a connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب خبرًا لليمين أو اضغط عليه مطولًا لحفظه هنا. تُفتح الأخبار المحفوظة دون اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische bei einem Artikel nach rechts oder halte ihn gedrückt, um ihn hier zu merken. Gemerkte Artikel öffnen sich auch offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha en una noticia o mantenla pulsada para guardarla aquí. Las noticias guardadas se abren sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un article vers la droite ou maintenez-le pour l'enregistrer ici. Les articles enregistrés s'ouvrent hors connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו ימינה על כתבה, או לחצו עליה לחיצה ארוכה, כדי לשמור אותה כאן. כתבות שמורות נפתחות ללא חיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कहानी पर दाईं ओर स्वाइप करें, या उसे दबाकर रखें, ताकि वह यहाँ सहेजी जाए। सहेजी गई कहानियाँ बिना कनेक्शन के खुलती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser berita ke kanan, atau tekan lama, untuk menyimpannya di sini. Berita tersimpan dapat dibuka tanpa koneksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a destra su un articolo, o tienilo premuto, per salvarlo qui. Gli articoli salvati si aprono anche offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を右にスワイプするか長押しすると、ここに保存されます。保存した記事はオフラインでも開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사를 오른쪽으로 쓸거나 길게 눌러 여기에 저장하세요. 저장한 기사는 오프라인에서도 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts op een artikel of houd het vast om het hier te bewaren. Bewaarde artikelen openen ook zonder verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń artykuł w prawo lub naciśnij go i przytrzymaj, aby zapisać go tutaj. Zapisane artykuły otwierają się bez połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize uma notícia para a direita ou mantenha-a pressionada para salvá-la aqui. Notícias salvas abrem sem conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните материал вправо или нажмите на него и удерживайте, чтобы сохранить его здесь. Сохраненные материалы открываются без подключения к сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt höger på en artikel, eller tryck länge på den, för att spara den här. Sparade artiklar öppnas utan anslutning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir haberi burada kaydetmek için sağa kaydırın ya da basılı tutun. Kaydedilen haberler bağlantı olmadan açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt phải một bài báo, hoặc nhấn giữ, để lưu vào đây. Các bài đã lưu mở được mà không cần kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在报道上向右轻扫或按住即可存储到这里。已存报道无需联网即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在報導上向右滑動或按住即可儲存到這裡。已儲存的報導不需連線即可開啟。"
          }
        }
      }
    },
    "Tap a feed to read only it. Swipe left to remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على موجز لقراءته وحده. اسحب لليسار لإزالته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Feed, um nur ihn zu lesen. Nach links wischen entfernt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un feed para leer solo ese. Desliza a la izquierda para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un flux pour ne lire que lui. Balayez vers la gauche pour le retirer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על הזנה כדי לקרוא רק ממנה. החליקו שמאלה כדי להסיר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ीड पर टैप करें ताकि केवल उसे पढ़ सकें। हटाने के लिए बाईं ओर स्वाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk feed untuk hanya membaca feed itu. Geser ke kiri untuk menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un feed per leggere solo quello. Scorri a sinistra per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードをタップするとそれだけを読めます。左にスワイプで削除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드를 탭하면 그 피드만 읽습니다. 왼쪽으로 쓸면 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een feed om alleen die te lezen. Veeg naar links om hem te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij kanał, aby czytać tylko jego. Przesuń w lewo, aby go usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um feed para ler só ele. Deslize para a esquerda para removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на ленту, чтобы читать только её. Смахните влево, чтобы удалить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett flöde för att bara läsa det. Svep åt vänster för att ta bort det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca o akışı okumak için dokunun. Kaldırmak için sola kaydırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn một nguồn tin để chỉ đọc nguồn đó. Vuốt trái để xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点订阅源即可只读它。向左轻扫可移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下訂閱源即可只讀它。向左滑動可移除。"
          }
        }
      }
    },
