        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביאו את ההזנות שלכם מקורא אחר, או קחו אותן איתכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ीड किसी और रीडर से लाएँ, या उन्हें अपने साथ ले जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa feed Anda dari pembaca lain, atau bawa feed ke mana saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta i tuoi feed da un altro lettore, o portali con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのリーダーからフィードを持ち込んだり、持ち出したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 리더에서 피드를 가져오거나 내보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je feeds mee uit een andere lezer, of neem ze mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś kanały z innego czytnika albo zabierz je ze sobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga seus feeds de outro leitor ou leve-os com você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите свои ленты из другого приложения для чтения или заберите их с собой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med dina flöden från en annan läsapp, eller ta med dem vidare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akışlarınızı başka bir okuyucudan getirin ya da yanınızda götürün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mang nguồn tin từ ứng dụng đọc khác, hoặc mang chúng theo bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他阅读器导入订阅源，或随身带走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從其他閱讀器匯入訂閱源，或隨身帶走。"
          }
        }
      }
    },
    "Bugle finds the site's feed and adds it the next time you open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر Bugle على موجز الموقع ويضيفه في المرة القادمة التي تفتحه فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle findet den Feed der Website und fügt ihn beim nächsten Öffnen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle encuentra el feed del sitio y lo añade la próxima vez que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle trouve le flux du site et l'ajoute à la prochaine ouverture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle מוצא את ההזנה של האתר ומוסיף אותה בפעם הבאה שתפתחו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle साइट का फ़ीड खोजता है और अगली बार खोलने पर उसे जोड़ देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle menemukan feed situs dan menambahkannya saat Anda membukanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle trova il feed del sito e lo aggiunge alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugleがサイトのフィードを見つけ、次に開いたときに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle이 사이트의 피드를 찾아 다음에 열 때 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle vindt de feed van de site en voegt die toe als je de app weer opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle znajduje kanał witryny i dodaje go przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bugle encontra o feed do site e o adiciona na próxima vez que você abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle найдёт ленту сайта и добавит её при следующем открытии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle hittar webbplatsens flöde och lägger till det nästa gång du öppnar den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle, sitenin akışını bulur ve bir sonraki açışınızda ekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle sẽ tìm nguồn tin của trang và thêm vào lần mở tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle 会找到该网站的订阅源，并在你下次打开时添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle 會找到該網站的訂閱源，並在你下次開啟時加入。"
          }
        }
      }
    },
