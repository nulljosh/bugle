    "Stories you open show up here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الأخبار التي تفتحها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel, die du öffnest, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noticias que abres aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
