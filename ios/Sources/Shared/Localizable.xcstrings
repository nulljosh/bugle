          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa tài khoản của bạn và các nguồn tin đã đồng bộ với tài khoản. Nguồn tin trên thiết bị này vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
