        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין פריטים. הוסיפו הזנה או משכו לרענון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई प्रविष्टि नहीं। फ़ीड जोड़ें या रीफ़्रेश करने के लिए खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada entri. Tambahkan feed atau tarik untuk menyegarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun articolo. Aggiungi un feed o trascina per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ記事がありません。フィードを追加するか、引っ張って更新してください。"
