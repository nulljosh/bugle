    "Today's biggest stories, each with every outlet covering it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرز أخبار اليوم، مع كل وسيلة تغطيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wichtigsten Nachrichten des Tages, jeweils mit allen Medien, die darüber berichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noticias más importantes de hoy, cada una con todos los medios que la cubren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les grands titres du jour, chacun avec tous les médias qui le couvrent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבות הגדולות של היום, כל אחת עם כל גופי התקשורת שמסקרים אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की सबसे बड़ी कहानियाँ, हर एक के साथ वे सभी आउटलेट जो उसे कवर कर रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berita terbesar hari ini, masing-masing dengan semua media yang meliputnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notizie più importanti di oggi, ognuna con tutte le testate che ne parlano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の大きなニュースを、報じているすべてのメディアとともに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 주요 기사와 이를 보도한 모든 매체."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het grootste nieuws van vandaag, elk met alle media die erover berichten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najważniejsze wiadomości dnia, każda z listą wszystkich mediów, które o niej piszą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As maiores notícias de hoje, cada uma com todos os veículos que a cobrem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главные новости дня, к каждой из которых приведены все издания, которые о ней пишут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens största nyheter, var och en med alla mediekällor som bevakar den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün en önemli haberleri, her biri için onu ele alan tüm yayın organlarıyla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những tin lớn nhất hôm nay, mỗi tin kèm mọi hãng tin đưa tin về nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日最重要的报道，附带所有报道它的媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日最重要的報導，附上所有報導它的媒體。"
          }
        }
      }
    },
