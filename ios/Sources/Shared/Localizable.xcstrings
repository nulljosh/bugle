          }
        }
      }
    },
    "Bring your feeds from another reader, or take them with you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring deine Feeds aus einem anderen Reader mit oder nimm sie mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae tus feeds desde otro lector o llévatelos contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez vos flux depuis un autre lecteur, ou emportez-les."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのリーダーからフィードを持ち込んだり、持ち出したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga seus feeds de outro leitor ou leve-os com você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他阅读器导入订阅源，或随身带走。"
          }
        }
      }
    },
    "Bugle finds the site's feed and adds it the next time you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle findet den Feed der Website und fügt ihn beim nächsten Öffnen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle encuentra el feed del sitio y lo añade la próxima vez que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle trouve le flux du site et l'ajoute à la prochaine ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugleがサイトのフィードを見つけ、次に開いたときに追加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bugle encontra o feed do site e o adiciona na próxima vez que você abrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugle 会找到该网站的订阅源，并在你下次打开时添加。"
          }
        }
      }
    },
