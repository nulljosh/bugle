    "The quick brown fox reads the news.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثعلب البني السريع يقرأ الأخبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schnelle braune Fuchs liest die Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rápido zorro marrón lee las noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapide renard brun lit les nouvelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La volpe marrone veloce legge le notizie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すばしこい茶色のキツネがニュースを読む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재빠른 갈색 여우가 뉴스를 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelle bruine vos leest het nieuws."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rápida raposa marrom lê as notícias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸在读新闻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸在讀新聞。"
          }
        }
      }
    },
    "This deletes your account and the feeds synced to it. Feeds on this device stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك والموجزات المتزامنة معه. تبقى الموجزات على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden dein Konto und die damit synchronisierten Feeds gelöscht. Die Feeds auf diesem Gerät bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y los feeds sincronizados con ella. Los feeds de este dispositivo se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime votre compte et les flux synchronisés. Les flux de cet appareil restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così elimini il tuo account e i feed sincronizzati. I feed su questo dispositivo restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと同期済みのフィードが削除されます。このデバイスのフィードは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 동기화된 피드가 삭제됩니다. 이 기기의 피드는 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je je account en de feeds die eraan gekoppeld zijn. De feeds op dit apparaat blijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga sua conta e os feeds sincronizados com ela. Os feeds deste dispositivo permanecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除你的账户及同步到其中的订阅源。此设备上的订阅源会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除你的帳號及同步到其中的訂閱源。此裝置上的訂閱源會保留。"
          }
        }
      }
    },
