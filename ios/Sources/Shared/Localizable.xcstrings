    "Search an outlet or a word on Home, then tap Mute to hide its stories. Swipe left to unmute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن وسيلة أو كلمة في الرئيسية، ثم اضغط كتم لإخفاء أخبارها. اسحب لليسار لإلغاء الكتم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche auf Start nach einem Medium oder Wort und tippe auf Stummschalten, um seine Artikel auszublenden. Nach links wischen hebt es auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un medio o una palabra en Inicio y toca Silenciar para ocultar sus noticias. Desliza a la izquierda para volver a mostrarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez un média ou un mot dans Accueil, puis touchez Masquer pour cacher ses articles. Balayez vers la gauche pour les réafficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca una testata o una parola in Home, poi tocca Silenzia per nasconderne gli articoli. Scorri a sinistra per riattivarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームでメディアや単語を検索し、「ミュート」をタップするとその記事を隠せます。左にスワイプで解除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 매체나 단어를 검색한 뒤 숨기기를 탭하면 해당 기사가 숨겨집니다. 왼쪽으로 쓸어 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek op Home naar een medium of woord en tik op Demp om de artikelen te verbergen. Veeg naar links om het dempen op te heffen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque um veículo ou uma palavra no Início e toque em Silenciar para ocultar as notícias. Deslize para a esquerda para reativar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首页搜索媒体或词语，然后轻点“静音”即可隐藏其报道。向左轻扫可取消静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在首頁搜尋媒體或字詞，然後點一下「靜音」即可隱藏其報導。向左滑動可取消靜音。"
          }
        }
      }
    },
