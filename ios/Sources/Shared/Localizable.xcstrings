    "Covered by %lld newsrooms. Leans are Bugle's own rating of each outlet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطّتها %lld غرف أخبار. الميول تقييم Bugle الخاص لكل وسيلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %lld Redaktionen berichtet. Die Ausrichtung ist Bugles eigene Einschätzung jedes Mediums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierta por %lld redacciones. Las tendencias son la valoración propia de Bugle de cada medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvert par %lld rédactions. Les tendances sont l'évaluation de chaque média par Bugle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coperta da %lld redazioni. Gli orientamenti sono la valutazione di Bugle per ogni testata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 社の報道機関が報じています。傾向は各メディアに対するBugle独自の評価です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 언론사가 보도했습니다. 성향은 각 매체에 대한 Bugle 자체 평가입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeld door %lld redacties. De richting is Bugles eigen beoordeling van elk medium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberta por %lld redações. As tendências são a avaliação do próprio Bugle sobre cada veículo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 %lld 家新闻机构报道。倾向是 Bugle 对各媒体的自有评级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 %lld 家新聞機構報導。傾向是 Bugle 對各媒體的自有評級。"
          }
        }
      }
    },
