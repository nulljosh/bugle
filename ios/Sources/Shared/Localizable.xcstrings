    "Covered by %lld newsrooms. Leans are Bugle's own rating of each outlet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطّتها %lld غرف أخبار. الميول تقييم Bugle الخاص لكل وسيلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %lld Redaktionen berichtet. Die Ausrichtung ist Bugles eigene Einschätzung jedes Mediums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierta por %lld redacciones. Las tendencias son la valoración propia de Bugle de cada medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvert par %lld rédactions. Les tendances sont l'évaluation de chaque média par Bugle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסוקר על ידי %lld מערכות חדשות. הנטייה היא הדירוג העצמאי של Bugle לכל גוף תקשורת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld न्यूज़रूम ने कवर किया। झुकाव हर मीडिया आउटलेट के बारे में Bugle की अपनी रेटिंग है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diliput oleh %lld redaksi. Kecenderungan adalah penilaian Bugle sendiri terhadap setiap media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coperta da %lld redazioni. Gli orientamenti sono la valutazione di Bugle per ogni testata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 社の報道機関が報じています。傾向は各メディアに対するBugle独自の評価です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 언론사가 보도했습니다. 성향은 각 매체에 대한 Bugle 자체 평가입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeld door %lld redacties. De richting is Bugles eigen beoordeling van elk medium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisywane przez %lld redakcje. Orientacja to ocena Bugle dla każdego medium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberta por %lld redações. As tendências são a avaliação do próprio Bugle sobre cada veículo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освещают %lld редакций. Направленность — собственная оценка Bugle для каждого СМИ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevakas av %lld redaktioner. Lutningen är Bugles egen bedömning av varje mediebolag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld haber merkezi tarafından ele alındı. Eğilimler, Bugle'ın her yayın organına verdiği kendi değerlendirmesidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được %lld tòa soạn đưa tin. Xu hướng là đánh giá riêng của Bugle đối với từng hãng tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 %lld 家新闻机构报道。倾向是 Bugle 对各媒体的自有评级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 %lld 家新聞機構報導。傾向是 Bugle 對各媒體的自有評級。"
          }
        }
      }
    },
