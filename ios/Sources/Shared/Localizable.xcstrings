    "This deletes your account and the feeds synced to it. Feeds on this device stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك والموجزات المتزامنة معه. تبقى الموجزات على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden dein Konto und die damit synchronisierten Feeds gelöscht. Die Feeds auf diesem Gerät bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y los feeds sincronizados con ella. Los feeds de este dispositivo se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime votre compte et les flux synchronisés. Les flux de cet appareil restent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את חשבונכם ואת ההזנות המסונכרנות אליו. ההזנות במכשיר הזה יישארו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपका खाता और उससे सिंक हुए फ़ीड हट जाएँगे। इस डिवाइस के फ़ीड बने रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus akun Anda dan feed yang disinkronkan ke sana. Feed di perangkat ini tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così elimini il tuo account e i feed sincronizzati. I feed su questo dispositivo restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと同期済みのフィードが削除されます。このデバイスのフィードは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 동기화된 피드가 삭제됩니다. 이 기기의 피드는 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je je account en de feeds die eraan gekoppeld zijn. De feeds op dit apparaat blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usunie Twoje konto i zsynchronizowane z nim kanały. Kanały na tym urządzeniu pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga sua conta e os feeds sincronizados com ela. Os feeds deste dispositivo permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит вашу учетную запись и синхронизированные с ней ленты. Ленты на этом устройстве останутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här raderar ditt konto och flödena som synkats till det. Flöden på den här enheten finns kvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
