    "The quick brown fox reads the news.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثعلب البني السريع يقرأ الأخبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schnelle braune Fuchs liest die Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rápido zorro marrón lee las noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapide renard brun lit les nouvelles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השועל החום המהיר קורא את החדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चपल भूरी लोमड़ी समाचार पढ़ती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubah cokelat yang cepat membaca berita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La volpe marrone veloce legge le notizie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すばしこい茶色のキツネがニュースを読む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재빠른 갈색 여우가 뉴스를 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelle bruine vos leest het nieuws."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki brązowy lis czyta wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rápida raposa marrom lê as notícias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая коричневая лиса читает новости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den snabba bruna räven läser nyheterna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı kahverengi tilki haberleri okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chú cáo nâu nhanh nhẹn đọc tin tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸在读新闻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸在讀新聞。"
          }
        }
      }
    },
