    "Add a feed or pull to refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Feed hinzu oder ziehe zum Aktualisieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un feed o desliza para actualizar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un flux ou tirez pour actualiser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードを追加するか、引っ張って更新"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um feed ou puxe para atualizar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加订阅源或下拉刷新"
          }
        }
      }
    },
    "Added %lld feeds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Feeds hinzugefügt"
