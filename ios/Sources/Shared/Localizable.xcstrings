    "Couldn't load feeds. Pull to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الموجزات. اسحب لإعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds konnten nicht geladen werden. Zum Wiederholen ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los feeds. Desliza para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les flux. Tirez pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון הזנות. משכו כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीड लोड नहीं हो सके। फिर से कोशिश करने के लिए खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed gagal dimuat. Tarik untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i feed. Trascina per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードを読み込めませんでした。引っ張って再試行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드를 불러올 수 없습니다. 당겨서 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan feeds niet laden. Trek om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać kanałów. Przeciągnij, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os feeds. Puxe para tentar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить ленты. Потяните, чтобы повторить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flöden kunde inte läsas in. Dra för att försöka igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akışlar yüklenemedi. Yeniden denemek için çekin."
          }
        },
        "vi": {
          "stringUnit": {
